#!/usr/bin/env bash
# Engine git rails — commit message quality. WARN ONLY, always.
#
# A bad message costs nothing today and everything at handover, when someone
# reads `git log` to work out why a thing is the way it is. That is a real
# engine concern — but it is also never worth stopping someone's commit over,
# so nothing here ever blocks.

set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
. "$DIR/lib.sh"

MSGFILE="$1"
# Strip comments and blank lines the way git itself does.
SUBJECT="$(grep -vE '^\s*#' "$MSGFILE" | grep -vE '^\s*$' | head -1 || true)"

[ -z "$SUBJECT" ] && exit 0
# Merges, reverts, fixups and squashes are generated by git — leave them alone.
case "$SUBJECT" in Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;; esac

LOWER="$(printf '%s' "$SUBJECT" | tr '[:upper:]' '[:lower:]' | sed 's/[[:punct:]]*$//')"

case "$LOWER" in
    wip|changes|change|updates|update|fix|fixes|fixed|stuff|misc|temp|test|asdf|.|..|minor|cleanup|refactor|commit)
        warn "Commit subject is \"$SUBJECT\"." \
             "At handover this line is the only explanation anyone gets. \"$SUBJECT\" explains nothing." \
             "Say what changed and why, e.g. \"fix: STATUS parser dropped rows with empty owner\"." \
             "Rewrite it now — the commit is not made yet:  git commit --amend"
        exit 0 ;;
esac

if [ "${#SUBJECT}" -lt 12 ]; then
    warn "Commit subject is only ${#SUBJECT} characters: \"$SUBJECT\"." \
         "Too short to mean anything to the next reader. Amend with 'git commit --amend' if you can do better."
fi

# A large diff with a one-line message is the pattern that hurts most at inheritance.
CHANGED="$(git diff --cached --numstat 2>/dev/null | wc -l | tr -d ' ')"
BODY="$(grep -vE '^\s*#' "$MSGFILE" | sed '1d' | grep -vE '^\s*$' || true)"
if [ "${CHANGED:-0}" -gt 15 ] && [ -z "$BODY" ]; then
    warn "$CHANGED files changed, but the message is a subject line with no body." \
         "A change this size needs a sentence on why, not just what." \
         "  git commit --amend     # add a blank line then a short paragraph"
fi

exit 0
